---
/* The page closer - the recurring "start a conversation" block. Deep indigo,
   centred, poster-scale type (the ring-of-words version was dropped 13 Sept -
   Lisa: too much purple, no spinning circles). */
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  ctaHref?: string;
  ctaLabel?: string;
}
const {
  eyebrow = 'Humans First',
  heading,
  body,
  ctaHref = '/contact',
  ctaLabel = 'Start a conversation',
} = Astro.props;
---
<section class="ib">
  <div class="container ib-inner">
    <p class="ib-eyebrow">{eyebrow}</p>
    <h2 class="ib-heading"><slot name="heading">{heading}</slot></h2>
    {body && <p class="ib-body">{body}</p>}
    <a href={ctaHref} class="btn btn-light ib-cta">
      {ctaLabel}<span class="arr">&rarr;</span>
    </a>
  </div>
</section>

<style>
  .ib { background: var(--c-indigo); color: #fff; }
  .ib-inner {
    padding-block: clamp(80px, 9vw, 136px);
    max-width: 920px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }
  .ib-eyebrow {
    display: inline-flex; align-items: center;
    font-size: var(--t-label); font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--c-lilac); background: rgba(255,255,255,0.10);
    border-radius: 999px; padding: 8px 16px; line-height: 1.2;
  }
  .ib-heading {
    font-family: var(--f-display); font-weight: 800;
    font-size: var(--t-h2); line-height: 0.98; letter-spacing: -0.04em;
    color: #fff; text-wrap: balance; max-width: 16ch;
  }
  .ib-body { font-size: var(--t-body-lg); color: var(--c-on-indigo); max-width: 50ch; }
  .ib-cta { margin-top: 6px; }
  .btn-light { background: #fff; color: var(--c-indigo); }
  .btn-light:hover { background: var(--c-lilac-2); color: var(--c-indigo); transform: translateY(-1px); }
</style>
