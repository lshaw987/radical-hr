  Instagram: 'M12 7.3a4.7 4.7 0 100 9.4 4.7 4.7 0 000-9.4zm0 7.75a3.05 3.05 0 110-6.1 3.05 3.05 0 010 6.1zM17.9 7.1a1.1 1.1 0 11-2.2 0 1.1 1.1 0 012.2 0zM12 3.2c2.4 0 2.68.01 3.63.05 2.44.11 3.58 1.27 3.69 3.69.04.95.05 1.23.05 3.63s-.01 2.68-.05 3.63c-.11 2.42-1.25 3.58-3.69 3.69-.95.04-1.23.05-3.63.05s-2.68-.01-3.63-.05c-2.44-.11-3.58-1.27-3.69-3.69C4.64 14.25 4.63 13.97 4.63 11.57s.01-2.68.05-3.63c.11-2.42 1.25-3.58 3.69-3.69.95-.04 1.23-.05 3.63-.05zM12 1.55c-2.44 0-2.75.01-3.71.05C5.02 1.75 3.2 3.56 3.05 6.83 3 7.79 3 8.1 3 10.54s.01 2.75.05 3.71c.15 3.27 1.97 5.08 5.24 5.23.96.04 1.27.05 3.71.05s2.75-.01 3.71-.05c3.27-.15 5.08-1.96 5.23-5.23.04-.96.05-1.27.05-3.71s-.01-2.75-.05-3.71c-.15-3.27-1.96-5.08-5.23-5.23C14.75 1.56 14.44 1.55 12 1.55z',
  YouTube: 'M21.6 7.2a2.5 2.5 0 00-1.76-1.77C18.3 5 12 5 12 5s-6.3 0-7.84.43A2.5 2.5 0 002.4 7.2 26 26 0 002 12a26 26 0 00.4 4.8 2.5 2.5 0 001.76 1.77C5.7 19 12 19 12 19s6.3 0 7.84-.43a2.5 2.5 0 001.76-1.77A26 26 0 0022 12a26 26 0 00-.4-4.8zM10 15V9l5.2 3L10 15z',
};
const socials = [
  { href: 'https://www.linkedin.com/company/radical-hr/', label: 'LinkedIn' },
  { href: 'https://www.facebook.com/radicalHRx/',         label: 'Facebook' },
  { href: 'https://www.instagram.com/radicalhrx/',        label: 'Instagram' },
  { href: 'https://www.youtube.com/@RadicalHRx',          label: 'YouTube' },
];
const lisaSocials = [
  { href: 'https://nz.linkedin.com/in/lisajshaw', label: 'LinkedIn' },
];
---
<footer class="ft">
  <div class="container ft-inner">
    <div class="ft-brand">
      <a href="/" class="ft-logo" aria-label="Radical HR - home"><img src="/images/logo-white.png" alt="Radical HR" width="180" height="23" /></a>
      <p class="ft-tag">Humans First. Not paperwork first, not compliance first. Humans.</p>
      <a href="mailto:lisashaw@radicalhr.nz" class="ft-email">lisashaw@radicalhr.nz</a>
      <a href="tel:+64292268862" class="ft-phone">029 226 8862</a>
      <div class="ft-social">
        <span class="ft-social-label">Follow Radical HR</span>
        <div class="ft-icons">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="ft-icon" aria-label={`Radical HR on ${s.label}`} title={s.label}>
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[s.label]} fill="currentColor"></path></svg>
            </a>
          ))}
        </div>
      </div>
      <div class="ft-social">
        <span class="ft-social-label">Lisa</span>
        <div class="ft-icons">
          {lisaSocials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="ft-icon" aria-label={`Lisa Shaw on ${s.label}`} title={s.label}>
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[s.label]} fill="currentColor"></path></svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="ft-cols">
      {cols.map((c) => (
        <div class="ft-col">
          <p class="ft-col-title">{c.title}</p>
          {c.links.map((l) => (
            <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="container ft-base">
    <span>Made with 💓 in Aotearoa, New Zealand · © {year} Radical HR Limited</span>
    <span class="ft-base-links">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </span>
  </div>
</footer>

<style>
  .ft {
    background: var(--c-indigo);
    color: rgba(255,255,255,0.78);
    padding-block: clamp(56px, 7vw, 96px) 28px;
  }
  .ft-inner {
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: clamp(40px, 6vw, 80px);
    padding-bottom: 48px;
    border-bottom: 1px solid var(--c-rule-dark);
  }
  .ft-logo img { height: 28px; width: auto; }
  .ft-tag { margin-top: 18px; max-width: 30ch; color: rgba(255,255,255,0.66); font-size: 15px; line-height: 1.6; }
  .ft-email { display: inline-block; margin-top: 18px; color: var(--c-lilac); font-weight: 600; }
  .ft-email:hover { color: #fff; }
  .ft-phone { display: block; margin-top: 6px; color: var(--c-lilac); font-weight: 600; }
  .ft-phone:hover { color: #fff; }
  .ft-social { display: flex; flex-direction: column; gap: 10px; margin-top: 22px; }
  .ft-social-label { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
  .ft-icons { display: flex; gap: 10px; }
  .ft-icon {
    width: 44px; height: 44px; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.10); color: #fff;
    transition: background .15s var(--ease-out), transform .15s var(--ease-out);
  }
  .ft-icon:hover { background: var(--c-purple); transform: translateY(-2px); }

  .ft-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .ft-col { display: flex; flex-direction: column; gap: 12px; }
  .ft-col-title {
    font-family: var(--f-display); font-weight: 700; color: #fff;
    font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 4px;
  }
  .ft-col a { font-size: 15px; color: rgba(255,255,255,0.74); }
  .ft-col a:hover { color: var(--c-lilac); }

  .ft-base {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px;
    margin-top: 24px; font-size: 13px; color: rgba(255,255,255,0.55);
  }
  .ft-base-links { display: flex; gap: 20px; }
  .ft-base-links a:hover { color: #fff; }

  @media (max-width: 760px) {
    .ft-inner { grid-template-columns: 1fr; gap: 36px; }
    .ft-cols { grid-template-columns: repeat(2, 1fr); gap: 28px; }
  }
</style>
