      { href: '/attract',             label: 'Attract' },
      { href: '/align',               label: 'Align' },
      { href: '/lead',                label: 'Lead' },
      { href: '/retain',              label: 'Retain' },
      { href: '/services#ai',         label: 'Ai, Done Humans First' },
      { href: '/strengths',           label: 'Strengths Coaching' },
      { href: '/recruitment-agency',  label: 'Recruitment' },
      { href: '/speaking',            label: 'Speaking & Keynotes' },
    ],
  },
  {
    title: 'Learn & grow',
    links: [
      { href: '/blog',      label: 'Blog' },
      { href: '/newsletter',label: 'Newsletter' },
      { href: '/book-nook', label: 'Book Nook' },
    ],
  },
  {
    title: 'About',
    links: [
      { href: '/about',        label: 'About us' },
      { href: '/values',       label: 'Values' },
      { href: '/work-with-us', label: 'Work with us' },
      { href: '/contact',      label: 'Contact' },
    ],
  },
  {
    title: 'Also built here',
    links: [
      { href: 'https://www.mpowerhq.nz', label: 'MPower', external: true },
      { href: '/about#ventures',         label: 'Waypoint' },
      { href: 'https://umpireroom.nz',   label: 'Umpire Room', external: true },
    ],
  },
];
// Business socials + Lisa's personal work channels. Her personal Instagram +
// Facebook slots are ready - add { href, label } entries to `lisaSocials`
// once Lisa supplies the handles (never guess URLs).
