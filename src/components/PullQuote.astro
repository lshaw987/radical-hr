---
/* A pull-quote band. Real words from real clients and participants, always
   role-anonymised (never a name). Source for every quote: layer-1-context/
   personal-brand.md testimonial bank, or the Fleet Image record
   (outputs/lisa-shaw/2026-08-21-fleet-image-the-people-story.md) - added
   2026-09-13 at Lisa's ask ("anonymise their quotes but weave them in"). */
import { quotes, type QuoteKey } from '../data/quotes';
interface Props { q: QuoteKey; tone?: 'white' | 'lilac'; }
const { q, tone = 'white' } = Astro.props;
const item = quotes[q];
---
<section class={`pq pq-${tone}`}>
  <div class="container">
    <figure class="pq-inner">
      <span class="pq-mark" aria-hidden="true">“</span>
      <blockquote class="pq-text">{item.text}</blockquote>
      <figcaption class="pq-who">{item.who}</figcaption>
    </figure>
  </div>
</section>

<style>
  .pq { padding-block: clamp(48px, 6vw, 88px); }
  .pq-white { background: #fff; }
  .pq-lilac { background: var(--c-lilac-2); }
  .pq-inner { max-width: 900px; margin-inline: auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .pq-mark { font-family: var(--f-display); font-weight: 800; font-size: clamp(72px, 8vw, 120px); line-height: 0.5; color: var(--c-lilac); height: 0.45em; }
  .pq-text { font-family: var(--f-display); font-weight: 600; font-size: clamp(22px, 1.8vw + 12px, 36px); line-height: 1.3; letter-spacing: -0.015em; color: var(--c-indigo); text-wrap: balance; }
  .pq-who { font-size: var(--t-body-sm); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-purple); }
</style>
