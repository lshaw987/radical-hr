---
interface Props { current?: string; }
const { current } = Astro.props;

// Mega-menu nav: three dropdown groups + the CTA. Each item carries a short
// description so a first-time visitor knows where a link goes before they
// click. CSS-only - hover/focus on desktop, grouped sections in the burger
// panel on mobile.
const groups = [
  {
    label: 'What we do',
    href: '/services',
    keys: ['services', 'attract', 'align', 'lead', 'retain'],
    wide: true,
    sections: [
      {
        title: 'The four pillars',
        items: [
          { href: '/attract', label: 'Attract', desc: 'Bring the right humans in' },
          { href: '/align',   label: 'Align',   desc: 'Everyone moving the same way' },
          { href: '/lead',    label: 'Lead',    desc: 'Leaders who multiply impact' },
          { href: '/retain',  label: 'Retain',  desc: 'Keep your best people thriving' },
        ],
      },
      {
        title: 'How we help',
        items: [
          { href: '/services',           label: 'All services',            desc: 'The full picture, in one place' },
          { href: '/strengths',          label: 'Strengths Coaching',      desc: 'Build on what people do best' },
          { href: '/recruitment-agency', label: 'Recruitment',             desc: 'Values-first, end to end' },
          { href: '/productivity',       label: 'Purposeful Productivity', desc: 'Lisa’s CARE Methodology' },
          { href: '/speaking',           label: 'Speaking & Keynotes',     desc: 'Talks that move the room' },
        ],
      },
    ],
  },
  {
    label: 'Learn & Grow',
    href: '/learn',
    keys: ['learn'],
    sections: [
      {
        items: [
          { href: '/blog',       label: 'Blog',       desc: 'The thinking, out loud' },
          { href: '/newsletter', label: 'Newsletter', desc: 'The good stuff, in your inbox' },
          { href: '/book-nook',  label: 'Book Nook',  desc: 'Honest reviews - a mirror, not a manual' },
        ],
      },
    ],
  },
  {
    label: 'About',
    href: '/about',
    keys: ['about'],
    sections: [
      {
        items: [
          { href: '/about',          label: 'About us',         desc: 'The story, and the human behind it' },
          { href: '/values',         label: 'Values',           desc: 'What we stand for - lived, not laminated' },
          { href: '/about#ventures', label: 'Sister companies', desc: 'MPower, Umpire Room and more' },
          { href: '/partner',        label: 'Partner with us',  desc: 'Better together' },
          { href: '/contact',        label: 'Contact',          desc: 'Start a conversation' },
        ],
      },
    ],
  },
];
---
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label="Radical HR - home">
      <img src="/images/logo.png" alt="Radical HR" width="180" height="23" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-burger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav-links" aria-label="Primary">
      {groups.map((g) => (
        <div class={[
          'nav-group',
          g.wide ? 'is-wide' : '',
          g.keys.includes(current ?? '') ? 'is-current-group' : '',
        ].filter(Boolean).join(' ')}>
          <a href={g.href} class="nav-top">
            {g.label}
            <svg class="chev" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div class="grp-menu">
            <div class="grp-panel">
              {g.sections.map((s) => (
                <div class="grp-section">
                  {s.title && <p class="grp-title">{s.title}</p>}
                  {s.items.map((l) => (
                    <a href={l.href} class={current === l.href.replace('/', '') ? 'grp-link is-current' : 'grp-link'}>
                      <span class="grp-label">{l.label}</span>
                      {l.desc && <span class="grp-desc">{l.desc}</span>}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
      <a href="/contact" class="btn btn-primary nav-cta">Start a conversation</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--c-rule-soft);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    gap: 24px;
  }
  .nav-logo { display: inline-flex; align-items: center; }
  .nav-logo img { height: 30px; width: auto; display: block; }
  @media (max-width: 480px) { .nav-logo img { height: 26px; } }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.6vw, 22px);
  }

  /* Top-level group links */
  .nav-group { position: relative; }
  .nav-top {
    display: inline-flex; align-items: center; gap: 6px;
    font-weight: 500; font-size: 15px; color: var(--c-body);
    padding: 10px 12px; border-radius: 999px;
    transition: color .15s var(--ease-out), background .15s var(--ease-out);
  }
  .nav-group:hover .nav-top,
  .nav-group:focus-within .nav-top,
  .is-current-group .nav-top { color: var(--c-purple); background: rgba(101,40,234,0.06); }
  .chev { transition: transform .18s var(--ease-out); color: var(--c-lavender); }
  .nav-group:hover .chev,
  .nav-group:focus-within .chev { transform: rotate(180deg); color: var(--c-purple); }

  /* Dropdown panel (desktop) */
  .grp-menu {
    position: absolute; top: 100%; left: 0;
    padding-top: 10px; /* hover bridge so the menu doesn't flicker shut */
    opacity: 0; pointer-events: none; transform: translateY(6px);
    transition: opacity .16s var(--ease-out), transform .16s var(--ease-out);
    z-index: 60;
  }
  .is-wide .grp-menu { left: 50%; transform: translate(-50%, 6px); }
  .nav-group:hover .grp-menu,
  .nav-group:focus-within .grp-menu {
    opacity: 1; pointer-events: auto; transform: translateY(0);
  }
  .is-wide:hover .grp-menu,
  .is-wide:focus-within .grp-menu { transform: translate(-50%, 0); }

  .grp-panel {
    display: flex; gap: 8px;
    background: #fff;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-lg);
    box-shadow: 0 22px 50px rgba(30,20,109,0.12);
    padding: 14px;
  }
  .grp-section { display: flex; flex-direction: column; gap: 2px; min-width: 250px; }
  .grp-title {
    font-family: var(--f-display); font-weight: 700;
    font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--c-lavender);
    padding: 8px 14px 6px;
  }
  .grp-link {
    display: flex; flex-direction: column; gap: 1px;
    padding: 9px 14px; border-radius: var(--radius-sm);
    transition: background .13s var(--ease-out);
    white-space: nowrap;
  }
  .grp-link:hover { background: rgba(101,40,234,0.07); }
  .grp-label { font-size: 15px; font-weight: 600; color: var(--c-indigo); transition: color .13s var(--ease-out); }
  .grp-link:hover .grp-label { color: var(--c-purple); }
  .grp-link.is-current .grp-label { color: var(--c-purple); }
  .grp-desc { font-size: 13px; color: var(--c-lavender); }

  .nav-cta { padding: 10px 18px; font-size: 15px; }

  /* mobile menu */
  .nav-toggle, .nav-burger { display: none; }
  .nav-burger {
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 8px;
  }
  .nav-burger span {
    width: 24px; height: 2px; background: var(--c-indigo);
    border-radius: 2px; transition: transform .2s var(--ease-out), opacity .2s;
  }

  @media (max-width: 1000px) {
    .nav-burger { display: flex; }
    .nav-links {
      position: absolute;
      top: 100%; left: 0; right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      padding: 12px var(--gutter) 28px;
      border-bottom: 1px solid var(--c-rule);
      box-shadow: 0 18px 40px rgba(30,20,109,0.08);
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity .18s var(--ease-out), transform .18s var(--ease-out);
      max-height: calc(100vh - 72px);
      overflow-y: auto;
    }
    .nav-toggle:checked ~ .nav-links {
      transform: translateY(0); opacity: 1; pointer-events: auto;
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Groups become labelled sections; menus always open */
    .nav-group { position: static; }
    .nav-top {
      padding: 16px 4px 6px;
      font-family: var(--f-display); font-weight: 700;
      font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--c-lavender);
      border-radius: 0;
      background: none !important;
    }
    .chev { display: none; }
    .grp-menu {
      position: static; opacity: 1; pointer-events: auto; transform: none !important;
      padding-top: 0;
    }
    .grp-panel {
      flex-direction: column; gap: 0;
      border: 0; box-shadow: none; border-radius: 0; padding: 0;
      background: transparent;
    }
    .grp-section { min-width: 0; }
    .grp-title { padding: 10px 8px 4px; }
    .grp-link {
      padding: 11px 8px; border-radius: 12px;
      border-bottom: 1px solid var(--c-rule-soft);
      white-space: normal;
    }
    .grp-label { font-size: 17px; }
    .nav-cta { margin-top: 18px; justify-content: center; }
  }
</style>
