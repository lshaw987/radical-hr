---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  current?: string;
  ogImage?: string;
}
const {
  title,
  description = 'Radical HR is a Humans First consultancy and movement. We help organisations attract, align, lead and retain extraordinary teams. Auckland, Aotearoa New Zealand.',
  current,
  ogImage = '/og-default.png',
} = Astro.props;
const fullTitle = title === 'Radical HR' ? title : `${title} · Radical HR`;

// Klaviyo onsite - powers embedded signup forms (e.g. the newsletter form on
// /newsletter). SKABCW is the confirmed umbrella Klaviyo account for every
// brand (Lisa's call 2026-06-14: MPower, Umpire Room and Radical HR all
// consolidate here; Campaign Monitor retired). Loaded site-wide so Klaviyo
// forms/popups can run on any page.
const KLAVIYO_COMPANY_ID = 'SKABCW';
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#6528EA" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    {/* Open Graph + Twitter */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Favicon - the real Radical HR two-circle mark */}
    <link rel="icon" type="image/png" href="/images/icon-mark.png" />
    <link rel="apple-touch-icon" href="/images/icon-mark.png" />

    {/* Preconnect to Google Fonts - real win on slow connections */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {/* Klaviyo onsite (embedded signup forms) */}
    {KLAVIYO_COMPANY_ID && (
      <script defer src={`https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=${KLAVIYO_COMPANY_ID}`}></script>
    )}

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      .skip-link {
        position: absolute; top: -100px; left: 16px;
        background: var(--c-purple); color: #fff;
        padding: 10px 14px; border-radius: 8px; font-weight: 600;
        z-index: 100;
      }
      .skip-link:focus { top: 16px; }
    </style>
  </body>
</html>
