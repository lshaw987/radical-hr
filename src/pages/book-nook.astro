---
import Base from '../layouts/Base.astro';
import IndigoBlock from '../components/IndigoBlock.astro';

// The nine real reviews, migrated from the old site (PDFs now hosted here in
// /public/reviews/ so they survive the WordPress retirement). Takes are only
// written where they're grounded in Lisa's own captured framing - the review
// PDF is the voice everywhere.
const reads = [
  {
    title: 'Belonging',
    author: 'Owen Eastwood',
    take: 'Whakapapa, identity and the deep human need to belong. Quiet, paradox-driven, and it stays with you.',
    pdf: '/reviews/Book-Review-Belonging.pdf',
  },
  {
    title: 'Tribes',
    author: 'Seth Godin',
    take: 'Leadership as courage, not authority - and the quiet cost of “sheepwalking” through work that deserves more of us.',
    pdf: '/reviews/Book-Review-Tribes-Seth-Godin.pdf',
  },
  {
    title: 'How to Change',
    author: 'Katy Milkman',
    take: 'Design beats willpower. The behavioural science of making change actually stick - for you and the people you lead.',
    pdf: '/reviews/Book-Review-Katy-Milkman-how-to-change.pdf',
  },
  {
    title: 'Atlas of the Heart',
    author: 'Brené Brown',
    pdf: '/reviews/Book-Review-Atlas-of-the-Heart.pdf',
  },
  {
    title: 'A Minute to Think',
    author: 'Juliet Funt',
    take: 'The case for white space - the breathing room your best thinking has been waiting for.',
    pdf: '/reviews/Book-Review-A-Minute-To-Think.pdf',
  },
  {
    title: 'Getting Things Done',
    author: 'David Allen',
    take: 'The chassis under how we work: your mind is for having ideas, not holding them.',
    pdf: '/reviews/Book-Review-Getting-Things-Done.pdf',
  },
  {
    title: 'Our Iceberg is Melting',
    author: 'John Kotter',
    pdf: '/reviews/Book-Review-Our-Iceberg-is-Melting.pdf',
  },
  {
    title: 'Playing Big',
    author: 'Tara Mohr',
    pdf: '/reviews/Book-Review-Playing-big.pdf',
  },
  {
    title: 'Oh, the Places You’ll Go!',
    author: 'Dr. Seuss',
    pdf: '/reviews/Book-Review-Oh-the-Places-Youll-Go.pdf',
  },
];
---
<Base
  title="Book Nook"
  description="The Book Nook - Lisa's honest book reviews, framed as a mirror, not a manual. And Radical Readers, the book club community, coming soon."
  current="learn"
>
  {/* Hero */}
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Radical Readers</p>
      <h1 class="display hero-h1">The Book Nook.</h1>
      <p class="body-lg hero-sub">
        The books shaping how we lead, with honest reviews you can read right
        now. And Radical Readers - the book club community where we read them
        together - is coming soon.
      </p>
    </div>
  </section>

  {/* Philosophy */}
  <section class="section-tight">
    <div class="container philosophy">
      <p class="heading philosophy-h">
        A good book is a mirror, <span class="accent">not a manual.</span>
      </p>
      <p class="body-lg">
        The best ones don’t tell you what to do - they remind you who you want to
        be. That’s how we read here. We tell the story, then name the framework,
        credit the thinker in full, and bring it back to the real, slightly messy
        work of leading humans.
      </p>
    </div>
  </section>

  {/* The reviews */}
  <section class="section band-mist">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">On the shelf</p>
        <h2 class="heading section-title">The reviews.</h2>
      </div>
      <div class="reads">
        {reads.map((r) => (
          <a href={r.pdf} target="_blank" rel="noopener" class="read">
            <h3 class="heading read-title">{r.title}</h3>
            <p class="read-author">{r.author}</p>
            {r.take && <p class="body read-take">{r.take}</p>}
            <span class="read-more">Read Lisa’s review <span class="arr">&rarr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <IndigoBlock
    eyebrow="Want in early?"
    heading="Be first into Radical Readers."
    body="The book club community is being built. Tell me you’re keen and I’ll let you know the moment the doors open."
    ctaHref="mailto:lisashaw@radicalhr.nz?subject=Radical%20Readers%20-%20count%20me%20in"
    ctaLabel="Register your interest"
  />
</Base>

<style>
  .hero { padding-block: clamp(56px, 9vw, 116px) clamp(28px, 4vw, 56px); }
  .hero-h1 { font-size: var(--t-h1); }
  .hero-sub { margin-top: 24px; max-width: 52ch; color: var(--c-body); }

  .philosophy { display: flex; flex-direction: column; gap: 18px; max-width: 62ch; }
  .philosophy-h { font-size: var(--t-h3); line-height: 1.2; max-width: 20ch; }
  .philosophy .body-lg { color: var(--c-body); }

  .section-title { font-size: var(--t-h2); }
  .reads { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 24px); }
  .read {
    display: flex; flex-direction: column; gap: 8px;
    background: #fff; border: 1px solid var(--c-rule); border-radius: var(--radius);
    padding: clamp(24px, 3vw, 34px);
    transition: transform .18s var(--ease-out), border-color .18s var(--ease-out), box-shadow .18s var(--ease-out);
  }
  .read:hover { transform: translateY(-3px); border-color: var(--c-lilac); box-shadow: 0 18px 40px rgba(101,40,234,0.08); }
  .read-title { font-size: var(--t-h4); }
  .read-author { font-family: var(--f-sans); font-size: var(--t-body-sm); font-weight: 600; letter-spacing: 0.04em; color: var(--c-purple); }
  .read-take { color: var(--c-body); margin-top: 4px; }
  .read-more { margin-top: auto; padding-top: 10px; font-weight: 600; font-size: 15px; color: var(--c-purple); }

  @media (max-width: 860px) { .reads { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .reads { grid-template-columns: 1fr; } }
</style>
