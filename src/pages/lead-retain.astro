---
import Base from '../layouts/Base.astro';
import IndigoBlock from '../components/IndigoBlock.astro';

const lead = [
  { name: 'Vivid LEADERS', line: 'Leadership development built by people who’ve actually led large teams and know the complexity first-hand. We equip leaders not merely to manage, but to be fresh, distinct leaders who make a difference.' },
  { name: 'Compelling Communication', line: 'Leadership is language - taking complex ideas and plans and communicating them in a way that compels people to respond and deliver.' },
  { name: 'Visionary Strategy', line: 'If a leader isn’t clear on the strategic priorities, there’s zero chance the team will be. We equip leaders to make the vision living and clear, organisation-wide.' },
];
const retain = [
  { name: 'Thrive Framework', line: 'Everything people need to thrive - role clarity, personal healthfulness, team connection, pay alignment, intentional development, and organisational influence.' },
  { name: 'Unique Belonging', line: 'To belong, people need to safely bring 100% of their unique selves to work - their identity, their strengths, their personal values.' },
  { name: 'Purposeful Productivity', line: 'People who stay believe what they do matters - and they have the tools to carry less stress and more focus, to achieve bigger results.' },
];
---
<Base
  title="Lead & Retain"
  description="Radically change how you equip leaders, then keep your best people by helping them thrive - leadership development and retention that lasts."
  current="lead-retain"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Pillars 03 + 04</p>
      <h1 class="display hero-h1">Lead well. Then keep your best humans.</h1>
      <p class="body-lg hero-sub">
        Most teams are managed, not led - because managers are never given the
        time and development to achieve phenomenal results. We change that, then
        build the kind of place people don’t want to leave.
      </p>
      <a href="/contact" class="btn btn-primary hero-cta">Talk leadership <span class="arr">&rarr;</span></a>
    </div>
  </section>

  {/* Lead */}
  <section class="section band-mist">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Pillar 03 · Lead</p>
        <h2 class="heading section-title">Radically change your leadership.</h2>
      </div>
      <div class="blocks">
        {lead.map((b) => (
          <div class="block">
            <h3 class="heading block-name">{b.name}</h3>
            <p class="body block-line">{b.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Retain */}
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Pillar 04 · Retain</p>
        <h2 class="heading section-title">Bring your whole self to work.</h2>
        <p class="body-lg section-intro">
          Loyalty leads to retention. Most organisations justify almost every
          resignation rather than solving the underlying challenge. We help you
          solve it.
        </p>
      </div>
      <div class="blocks">
        {retain.map((b) => (
          <div class="block block-light">
            <h3 class="heading block-name">{b.name}</h3>
            <p class="body block-line">{b.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <IndigoBlock
    eyebrow="Pillars 03 + 04"
    heading="Leaders who multiply impact. People who stay."
    ctaHref="/contact"
    ctaLabel="Start a conversation"
  />
</Base>

<style>
  .hero { padding-block: clamp(56px, 9vw, 116px) clamp(36px, 5vw, 64px); }
  .hero-h1 { font-size: var(--t-h1); max-width: 18ch; }
  .hero-sub { margin-top: 24px; max-width: 56ch; color: var(--c-body); }
  .hero-cta { margin-top: 32px; }

  .section-title { font-size: var(--t-h2); }
  .section-intro { max-width: 52ch; color: var(--c-body); }

  .blocks { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 24px); }
  .block { background: #fff; border: 1px solid var(--c-rule); border-radius: var(--radius); padding: clamp(24px, 3vw, 34px); display: flex; flex-direction: column; gap: 12px; }
  .block-light { background: var(--c-mist); }
  .block-name { font-size: var(--t-h4); color: var(--c-purple); }
  .block-line { color: var(--c-body); }

  @media (max-width: 760px) { .blocks { grid-template-columns: 1fr; } }
</style>
