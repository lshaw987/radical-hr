---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IndigoBlock from '../../components/IndigoBlock.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((review) => ({ params: { slug: review.slug }, props: { review } }));
}

const { review } = Astro.props;
const { Content } = await review.render();
---
<Base title={`${review.data.title} - review`} description={`Lisa's review of ${review.data.title} by ${review.data.author}. A mirror, not a manual.`} current="learn">
  <article class="review">
    <div class="container review-inner">
      <div class="review-head">
        {review.data.cover && (
          <img class="review-cover" src={review.data.cover} alt={`${review.data.title} by ${review.data.author} - book cover`} loading="eager" />
        )}
        <div class="review-meta">
          <p class="eyebrow">The Book Nook</p>
          <h1 class="display review-h1">{review.data.title}</h1>
          <p class="review-author">{review.data.author}</p>
          {review.data.pdf && (
            <a href={review.data.pdf} target="_blank" rel="noopener" class="review-pdf">Download the review (PDF) <span class="arr">&rarr;</span></a>
          )}
        </div>
      </div>
      <div class="prose">
        <Content />
      </div>
      <a href="/book-nook" class="btn btn-ghost review-back"><span class="arr">&larr;</span> Back to the Book Nook</a>
    </div>
  </article>

  <IndigoBlock
    eyebrow="Want in early?"
    heading="Be first into Radical Readers."
    body="The book club community is being built. Tell me you’re keen and I’ll let you know the moment the doors open."
    ctaHref="mailto:lisashaw@radicalhr.nz?subject=Radical%20Readers%20-%20count%20me%20in"
    ctaLabel="Register your interest"
  />
</Base>

<style>
  .review { padding-block: clamp(48px, 8vw, 104px) clamp(48px, 7vw, 96px); }
  .review-inner { max-width: 760px; }

  .review-head { display: flex; gap: clamp(24px, 4vw, 44px); align-items: flex-end; }
  .review-cover {
    width: clamp(120px, 18vw, 180px); height: auto; flex-shrink: 0;
    border-radius: var(--radius-sm); border: 1px solid var(--c-rule);
    box-shadow: 0 18px 40px rgba(30,20,109,0.14);
  }
  .review-meta { display: flex; flex-direction: column; gap: 10px; }
  .review-h1 { font-size: var(--t-h2); line-height: 1.1; }
  .review-author { font-family: var(--f-display); font-weight: 700; color: var(--c-purple); }
  .review-pdf { font-size: var(--t-body-sm); font-weight: 600; color: var(--c-lavender); }
  .review-pdf:hover { color: var(--c-purple); }
  @media (max-width: 560px) { .review-head { flex-direction: column; align-items: flex-start; } }

  .prose { margin-top: clamp(28px, 4vw, 48px); display: flex; flex-direction: column; gap: 4px; }
  .prose :global(p) { color: var(--c-body); font-size: var(--t-body); line-height: 1.75; margin-block: 10px; }
  .prose :global(h2) { font-family: var(--f-display); font-weight: 700; color: var(--c-indigo); font-size: var(--t-h4); margin-top: 30px; margin-bottom: 4px; letter-spacing: -0.01em; }
  .prose :global(h3) { font-family: var(--f-display); font-weight: 700; color: var(--c-indigo); font-size: var(--t-body-lg); margin-top: 22px; }
  .prose :global(ul), .prose :global(ol) { display: flex; flex-direction: column; gap: 8px; padding-left: 24px; margin-block: 12px; }
  .prose :global(li) { color: var(--c-body); line-height: 1.7; }
  .prose :global(blockquote) { border-left: 3px solid var(--c-lilac); padding-left: 18px; margin-block: 16px; color: var(--c-indigo); font-weight: 500; }
  .prose :global(strong) { color: var(--c-indigo); }

  .review-back { margin-top: clamp(28px, 4vw, 44px); }
</style>
