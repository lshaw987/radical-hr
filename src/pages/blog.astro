---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IndigoBlock from '../components/IndigoBlock.astro';
import { blogImage } from '../data/blogImages';

// Real posts, migrated verbatim from the old WordPress site. Ordered as the
// old blog listed them (order 1 = newest). Slugs match the old URLs.
const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order);
const [featured, ...rest] = posts;
const fImg = blogImage(featured.slug);
---
<Base
  title="Blog"
  description="The Radical HR blog - leadership, culture, productivity and the future of work. Tell the story, then name the framework."
  current="learn"
>
  {/* Hero */}
  <section class="hero">
    <div class="container">
      <p class="eyebrow">The blog</p>
      <h1 class="display hero-h1">Thinking out loud.</h1>
      <p class="body-lg hero-sub">
        Leadership, culture, productivity and the future of work - grounded in
        real mahi, not theory for hire. Tell the story, then name the framework.
      </p>
    </div>
  </section>

  {/* Featured - the latest piece */}
  <section class="section-tight">
    <div class="container">
      <a href={`/blog/${featured.slug}`} class="featured">
        {fImg && <div class="featured-photo"><img src={fImg.src} alt={fImg.alt} loading="eager" /></div>}
        <div class="featured-body">
          <p class="eyebrow">Latest</p>
          {featured.data.pillar && <span class="chip">{featured.data.pillar}</span>}
          <h2 class="heading featured-title">{featured.data.title}</h2>
          {featured.data.description && <p class="body-lg featured-line">{featured.data.description}</p>}
          <span class="postcard-more">Read <span class="arr">&rarr;</span></span>
        </div>
      </a>
    </div>
  </section>

  {/* Posts */}
  <section class="section band-mist">
    <div class="container">
      <div class="posts">
        {rest.map((p) => {
          const img = blogImage(p.slug);
          return (
            <a href={`/blog/${p.slug}`} class="postcard">
              {img && <div class="postcard-photo"><img src={img.src} alt={img.alt} loading="lazy" /></div>}
              <div class="postcard-body">
                {p.data.pillar && <span class="chip">{p.data.pillar}</span>}
                <h2 class="heading postcard-title">{p.data.title}</h2>
                {p.data.description && <p class="body postcard-line">{p.data.description}</p>}
                <span class="postcard-more">Read <span class="arr">&rarr;</span></span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <IndigoBlock
    eyebrow="Don’t miss the next one"
    heading="Get new pieces in your inbox."
    body="Subscribe to the newsletter and the writing comes to you - no clutter, unsubscribe any time."
    ctaHref="/newsletter"
    ctaLabel="Subscribe"
  />
</Base>

<style>
  .hero { padding-block: clamp(56px, 9vw, 116px) clamp(28px, 4vw, 56px); }
  .hero-h1 { font-size: var(--t-h1); }
  .hero-sub { margin-top: 24px; max-width: 54ch; color: var(--c-body); }

  .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 24px); }
  .featured {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(24px, 4vw, 56px); align-items: center;
    background: #fff; border-radius: var(--radius-lg); overflow: hidden;
    box-shadow: 0 18px 40px rgba(101,40,234,0.08);
    transition: transform .18s var(--ease-out);
  }
  .featured:hover { transform: translateY(-3px); }
  .featured-photo { aspect-ratio: 4 / 3; }
  .featured-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .featured-body { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: clamp(24px, 3vw, 44px) clamp(24px, 3vw, 44px) clamp(24px, 3vw, 44px) 0; }
  .featured-title { font-size: var(--t-h3); }
  .featured-line { color: var(--c-body); }
  @media (max-width: 860px) { .featured { grid-template-columns: 1fr; } .featured-body { padding: 0 24px 28px; } }

  .postcard {
    display: flex; flex-direction: column;
    background: #fff; border-radius: var(--radius-lg); overflow: hidden;
    transition: transform .18s var(--ease-out), border-color .18s var(--ease-out), box-shadow .18s var(--ease-out);
  }
  .postcard:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(101,40,234,0.10); }
  .postcard-photo { aspect-ratio: 16 / 10; }
  .postcard-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .postcard-body { display: flex; flex-direction: column; gap: 12px; padding: clamp(20px, 2.5vw, 28px); flex: 1; }
  .chip {
    align-self: flex-start;
    font-family: var(--f-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--c-purple); background: rgba(101,40,234,0.08);
    padding: 5px 10px; border-radius: 999px;
  }
  .postcard-title { font-size: var(--t-body-lg); line-height: 1.3; }
  .postcard-line { color: var(--c-body); font-size: var(--t-body-sm); }
  .postcard-more { margin-top: auto; font-weight: 600; font-size: 15px; color: var(--c-purple); }

  @media (max-width: 960px) { .posts { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .posts { grid-template-columns: 1fr; } }
</style>
