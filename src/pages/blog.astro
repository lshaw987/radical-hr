---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import IndigoBlock from '../components/IndigoBlock.astro';

// Real posts, migrated verbatim from the old WordPress site. Ordered as the
// old blog listed them (order 1 = newest). Slugs match the old URLs.
const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Blog"
  description="The Radical HR blog - leadership, culture, productivity and the future of work. Tell the story, then name the framework."
  current="learn"
>
  {/* Hero */}
  <section class="hero">
    <div class="container">
      <p class="eyebrow">The blog</p>
      <h1 class="display hero-h1">Thinking out loud.</h1>
      <p class="body-lg hero-sub">
        Leadership, culture, productivity and the future of work - grounded in
        real mahi, not theory for hire. Tell the story, then name the framework.
      </p>
    </div>
  </section>

  {/* Posts */}
  <section class="section band-mist">
    <div class="container">
      <div class="posts">
        {posts.map((p) => (
          <a href={`/blog/${p.slug}`} class="postcard">
            {p.data.pillar && <span class="chip">{p.data.pillar}</span>}
            <h2 class="heading postcard-title">{p.data.title}</h2>
            {p.data.description && <p class="body postcard-line">{p.data.description}</p>}
            <span class="postcard-more">Read <span class="arr">&rarr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <IndigoBlock
    eyebrow="Don’t miss the next one"
    heading="Get new pieces in your inbox."
    body="Subscribe to the newsletter and the writing comes to you - no clutter, unsubscribe any time."
    ctaHref="/newsletter"
    ctaLabel="Subscribe"
  />
</Base>

<style>
  .hero { padding-block: clamp(56px, 9vw, 116px) clamp(28px, 4vw, 56px); }
  .hero-h1 { font-size: var(--t-h1); }
  .hero-sub { margin-top: 24px; max-width: 54ch; color: var(--c-body); }

  .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 24px); }
  .postcard {
    display: flex; flex-direction: column; gap: 12px;
    background: #fff; border: 1px solid var(--c-rule); border-radius: var(--radius);
    padding: clamp(22px, 3vw, 32px);
    transition: transform .18s var(--ease-out), border-color .18s var(--ease-out), box-shadow .18s var(--ease-out);
  }
  .postcard:hover { transform: translateY(-3px); border-color: var(--c-lilac); box-shadow: 0 18px 40px rgba(101,40,234,0.08); }
  .chip {
    align-self: flex-start;
    font-family: var(--f-sans); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--c-purple); background: rgba(101,40,234,0.08);
    padding: 5px 10px; border-radius: 999px;
  }
  .postcard-title { font-size: var(--t-body-lg); line-height: 1.3; }
  .postcard-line { color: var(--c-body); font-size: var(--t-body-sm); }
  .postcard-more { margin-top: auto; font-weight: 600; font-size: 15px; color: var(--c-purple); }

  @media (max-width: 960px) { .posts { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .posts { grid-template-columns: 1fr; } }
</style>
