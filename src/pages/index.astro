---
import Base from '../layouts/Base.astro';
import IndigoBlock from '../components/IndigoBlock.astro';

// v2 "Big energy" home (Option D on the design canvas - Lisa's pick,
// 2026-09-13). Copy is the reviewed copy from the 12 Sept sitting, verbatim;
// only the hierarchy moved: "Humans First." is the poster word, the reviewed
// H1 sits under it as the tagline.

const pillars = [
  {
    no: '01',
    name: 'Attract',
    line: 'Bring the right people in. Not cookie-cutter recruitment - humans who believe in your mission, not just fill a seat.',
    href: '/attract',
    tone: 'purple',
  },
  {
    no: '02',
    name: 'Align',
    line: 'Get everyone moving the same way. Cut through the noise and corporate fluff to shared purpose, clear strategy, and values that actually mean something.',
    href: '/align',
    tone: 'indigo',
  },
  {
    no: '03',
    name: 'Lead',
    line: 'Build leaders who multiply impact. Not carrying the weight alone - building others strong enough to carry it with you.',
    href: '/lead',
    tone: 'lilac',
  },
  {
    no: '04',
    name: 'Retain',
    line: 'Keep your best humans thriving. Not beanbags and ping-pong - belonging, strengths and trust, so people want to stay.',
    href: '/retain',
    tone: 'pale',
  },
];

const steps = [
  {
    name: 'Connect',
    line: 'We start with a conversation. No jargon, no generic templates - just real korero about where you are, what’s working, and what’s getting in the way.',
    tone: 'purple',
  },
  {
    name: 'Co-Design',
    line: 'Together, we map a clear and practical plan. Strategy, leadership, or culture - we design it with you, not for you. Then we make it real.',
    tone: 'indigo',
  },
  {
    name: 'Create Impact',
    line: 'Your people engaged, your leaders equipped, and your culture built to last.',
    tone: 'white',
  },
];

const tags = ['Attract', 'Align', 'Lead', 'Retain', 'Leadership', 'Strategy', 'Culture', 'Ai', 'Boardroom', 'Paddock', 'Strengths', 'Hauora'];

// Role-anonymised on purpose (Lisa's rule: real quotes, roles not names -
// never de-anonymise). Sources in layer-1-context/personal-brand.md.
const quotes = [
  {
    text: 'I have really enjoyed your facilitation. You do an amazing job of making the principals feel comfortable and able to be vulnerable with how they are going. Your amazing list of resources is another highlight for me.',
    who: 'Leadership programme participant · education',
  },
  {
    text: 'I found the course to be highly engaging and your presenting style to be a huge motivator. I enjoyed the way you were able to push us out of our comfort zones in a supportive and caring way.',
    who: 'Strengths session participant',
  },
  {
    text: 'Your little tips and tricks have been amazing for me - efficient ways of being organised overall, and how to streamline admin processes in a school.',
    who: 'School leader',
  },
];
const [lead, ...rest] = quotes;
const ringText = 'HUMANS FIRST · EXTRAORDINARY TEAMS · FUTURE READY · '.repeat(2);
---
<Base
  title="Radical HR"
  description="Radical HR is a Humans First consultancy and movement. We help organisations attract, align, lead and retain extraordinary teams - by designing workplaces humans genuinely want to be part of."
  current="home"
>
  {/* ---------- Hero: the poster ---------- */}
  <section class="hero hero-home">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="display hero-word">Humans<br />First.</h1>
        <p class="heading hero-tag">
          Reimagining the future of <span class="accent">extraordinary</span> teams
        </p>
        <div class="hero-cta">
          <a href="/contact" class="btn btn-primary">Start a conversation <span class="arr">&rarr;</span></a>
          <a href="#approach" class="btn btn-ghost">How we work</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="hero-blob"></div>
        <svg class="hero-ring" viewBox="0 0 560 560">
          <defs><path id="home-ring" d="M280,280 m-250,0 a250,250 0 1,1 500,0 a250,250 0 1,1 -500,0"></path></defs>
          <text font-family="Poppins, sans-serif" font-weight="700" font-size="30" letter-spacing="6" fill="#FFFFFF"><textPath href="#home-ring">{ringText}</textPath></text>
        </svg>
        <div class="hero-photo">
          <img src="/images/lisa.png" alt="" loading="eager" />
        </div>
      </div>
    </div>
    <div class="container tags" aria-hidden="true">
      {tags.map((t, i) => <span class={`pill tag tag-${i % 4}`}>{t}</span>)}
    </div>
  </section>

  {/* ---------- The statement (white) ---------- */}
  <section class="section statement">
    <div class="container statement-inner">
      <p class="statement-kicker">We help organisations attract, align, lead and retain extraordinary teams by putting humans first.</p>
      <p class="display statement-line">
        Leadership, strategy, culture and Ai, all built around people.
        <span class="accent">Not policies. Not paperwork. Not buzzwords.</span>
      </p>
      <p class="body-lg statement-sub">
        When culture becomes wallpaper, great people walk. When strategy
        stays in a document, nobody follows it. When leadership stays stuck,
        potential is lost.
      </p>
    </div>
  </section>

  {/* ---------- Core message (pale lilac) ---------- */}
  <section class="section band-mist">
    <div class="container lede">
      <div class="circle lede-circle">Intentionally.<br />Courageously.<br />Together.</div>
      <p class="heading lede-text">
        When you put humans at the heart of everything - the strategy, the
        leadership, and the way you use Ai - teams work smarter, lead stronger,
        and deliver lasting impact. Radical HR exists to help organisations
        design for that future.
      </p>
    </div>
  </section>

  {/* ---------- What's at stake (indigo) ---------- */}
  <section class="section block-indigo">
    <div class="container stakes">
      <p class="eyebrow">We know what’s at stake</p>
      <h2 class="display stakes-h">
        You’re here because you don’t want to survive the future of work.
        You want to <span class="accent">shape</span> it.
      </h2>
      <div class="stakes-cards">
        <div class="stake">
          <p class="body-lg">You want a culture that’s real, not wallpaper. Leaders who inspire, not just manage. A team that’s aligned, energised and ready for what’s next.</p>
        </div>
        <div class="stake">
          <p class="body-lg">Unfortunately, too many organisations are stuck inside systems built for yesterday, or even worse - last century! Values sit on the wall instead of living in the work. Leaders carry the load alone, and have never been taught how to lead. Great people burn out instead of thriving.</p>
        </div>
        <div class="stake stake-turn">
          <p class="body-lg">That’s where Radical HR comes in. We’ve led through this, fixed it, and helped teams become extraordinary.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- Four pillars: the Venn (white) ---------- */}
  <section id="pillars" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The model</p>
        <h2 class="display section-title">Four pillars. One Humans First thread.</h2>
      </div>
      <div class="venn" aria-hidden="true">
        {pillars.map((p) => <a href={p.href} class={`circle venn-c venn-${p.tone}`}>{p.name}</a>)}
      </div>
      <div class="pillars">
        {pillars.map((p) => (
          <a href={p.href} class="pillar">
            <p class="body pillar-line"><strong class="pillar-name">{p.name}.</strong> {p.line}</p>
            <span class="pillar-more">Explore <span class="arr">&rarr;</span></span>
          </a>
        ))}
      </div>
      <p class="body-lg pillars-intro">
        Extraordinary teams are never a fluke. They’re intentional.
        Strategic. Human. Our work is built around four pillars that shape
        every piece of mahi we do.
      </p>
    </div>
  </section>

  {/* ---------- Founder (purple) ---------- */}
  <section class="section block-purple">
    <div class="container founder">
      <div class="founder-photo">
        <img src="/images/lisa.png" alt="Lisa Shaw, Founder of Radical HR." loading="lazy" />
      </div>
      <div class="founder-body">
        <p class="eyebrow">Lived, not theory</p>
        <h2 class="display founder-h">The person behind Humans First.</h2>
        <p class="body-lg">
          Radical HR is led by Lisa Shaw - founder, fractional exec, and a
          recovering accountant who traded spreadsheets for systems that scale
          impact. She’s run businesses, made payroll with no cash in the bank,
          sat on boards, and made the hard calls.
        </p>
        <p class="body founder-sub">
          The work is grounded in having actually carried the weight - comfortable
          in both the boardroom and the paddock. Not theory for hire.
        </p>
        <a href="/about" class="btn btn-primary founder-cta">Meet Lisa <span class="arr">&rarr;</span></a>
      </div>
    </div>
  </section>

  {/* ---------- Three-step approach (pale lilac) ---------- */}
  <section id="approach" class="section band-mist">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How we work</p>
        <h2 class="display section-title">Our radical approach is simple.</h2>
      </div>
      <div class="steps">
        {steps.map((s, i) => (
          <div class="step">
            <span class={`circle step-no step-${s.tone}`}>{i + 1}</span>
            <h3 class="heading step-name">{s.name}</h3>
            <p class="body step-line">{s.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- Provocation (white) ---------- */}
  <section class="section thesis-wrap">
    <div class="container thesis">
      <p class="eyebrow">The provocation</p>
      <h2 class="display thesis-q">
        What if we got rid of HR departments and made them <span class="accent">HF?</span>
      </h2>
      <p class="body-lg thesis-body">
        Humans First. We’re not here to drown you in policies and paperwork.
        We’re here to build teams people actually want to be part of. Because
        extraordinary teams aren’t born. They’re designed… radically.
      </p>
    </div>
  </section>

  {/* ---------- Testimonials (indigo) ---------- */}
  <section class="section block-indigo">
    <div class="container quotes">
      <p class="eyebrow">What leaders are saying</p>
      <figure class="quote-lead">
        <span class="quote-mark" aria-hidden="true">“</span>
        <blockquote class="heading quote-lead-text">{lead.text}</blockquote>
        <figcaption class="quote-who">{lead.who}</figcaption>
      </figure>
      <div class="quotes-rest">
        {rest.map((q) => (
          <figure class="quote">
            <blockquote class="body quote-text">“{q.text}”</blockquote>
            <figcaption class="quote-who">{q.who}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- Closer (purple, with the ring) ---------- */}
  <IndigoBlock
    eyebrow="We’re ready when you are"
    heading="Let’s build your extraordinary team together."
    body="The future you want isn’t out of reach - it’s waiting to be designed. Start with a conversation. No pitch, no jargon. Just where you’re at and where you want to get to."
    ctaHref="/contact"
    ctaLabel="Start a conversation"
  />
</Base>

<style>
  /* Hero: the poster */
  .hero-home { padding-bottom: clamp(40px, 5vw, 72px) !important; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(20px, 2.5vw, 32px); position: relative; z-index: 1; }
  .hero-word { font-size: var(--t-poster); line-height: 0.9; }
  .hero-tag { font-size: clamp(24px, 2.6vw + 8px, 40px); max-width: 16ch; color: #fff; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }

  .hero-visual { position: relative; aspect-ratio: 1; max-width: 560px; width: 100%; margin-inline: auto; }
  .hero-blob {
    position: absolute; right: -18%; top: -6%; width: 120%; height: 120%;
    border-radius: 999px; background: var(--c-lilac); opacity: 0.35;
  }
  .hero-ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 60s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .hero-photo {
    position: absolute; left: 18%; top: 16%; width: 64%; height: 70%;
    border-radius: var(--radius-xl); overflow: hidden;
    box-shadow: 0 40px 80px rgba(30,20,109,0.4);
  }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }

  .tags { display: flex; gap: 12px; flex-wrap: wrap; margin-top: clamp(32px, 4vw, 56px); }
  .tag { color: #fff; }
  .tag-0 { background: #fff; color: var(--c-purple); border-color: #fff; }
  .tag-2 { background: var(--c-indigo); border-color: var(--c-indigo); }
  .tag-3 { background: var(--c-lilac); color: var(--c-indigo); border-color: var(--c-lilac); }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { max-width: 420px; }
    .tags .pill { font-size: var(--t-body-sm); padding: 10px 16px; }
  }

  /* Statement */
  .statement-inner { display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px); }
  .statement-kicker { font-size: var(--t-body-lg); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-purple); max-width: 60ch; }
  .statement-line { font-size: var(--t-h2); max-width: 20ch; letter-spacing: -0.035em; line-height: 1.0; }
  .statement-sub { max-width: 46ch; color: var(--c-body); }

  /* Lede */
  .lede { display: grid; grid-template-columns: auto 1fr; gap: clamp(32px, 5vw, 80px); align-items: center; }
  .lede-circle {
    width: clamp(220px, 26vw, 380px); height: clamp(220px, 26vw, 380px);
    background: var(--c-purple); color: #fff;
    font-size: clamp(20px, 2.2vw, 34px); font-weight: 700; text-align: center; line-height: 1.2;
    padding: 32px;
  }
  .lede-text { font-size: clamp(26px, 2.6vw + 8px, 48px); line-height: 1.2; }
  @media (max-width: 860px) { .lede { grid-template-columns: 1fr; justify-items: start; } }

  /* Stakes */
  .stakes { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(32px, 4vw, 56px); }
  .stakes-h { font-size: var(--t-h2); max-width: 14ch; }
  .stakes-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 32px); width: 100%; }
  .stake { background: rgba(255,255,255,0.08); border-radius: var(--radius-lg); padding: clamp(28px, 3vw, 40px); }
  .stake .body-lg { font-size: var(--t-body-lg); }
  .stake-turn { background: var(--c-purple); }
  .stake-turn .body-lg { color: #fff; font-weight: 700; }
  @media (max-width: 860px) { .stakes-cards { grid-template-columns: 1fr; } }

  /* Pillars: the Venn */
  .section-title { font-size: var(--t-h2); }
  .venn { display: flex; justify-content: center; align-items: center; margin-bottom: clamp(40px, 5vw, 64px); }
  .venn-c {
    width: clamp(120px, 21vw, 300px); height: clamp(120px, 21vw, 300px);
    margin-right: clamp(-28px, -4.5vw, -60px);
    font-size: clamp(16px, 3vw, 44px); font-weight: 800;
    position: relative; opacity: 0.94;
    transition: transform .2s var(--ease-out);
  }
  .venn-c:last-child { margin-right: 0; }
  .venn-c:hover { transform: translateY(-6px); opacity: 1; z-index: 9; }
  .venn-purple { background: var(--c-purple); color: #fff; z-index: 1; }
  .venn-indigo { background: var(--c-indigo); color: #fff; z-index: 2; }
  .venn-lilac  { background: var(--c-lilac); color: var(--c-indigo); z-index: 3; }
  .venn-pale   { background: var(--c-lilac-2); color: var(--c-purple); z-index: 4; }

  .pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2.5vw, 32px); }
  .pillar { display: flex; flex-direction: column; gap: 12px; }
  .pillar-line { color: var(--c-body); }
  .pillar-name { color: var(--c-purple); font-weight: 700; }
  .pillar-more { font-weight: 600; font-size: var(--t-body-sm); color: var(--c-purple); }
  .pillars-intro { margin-top: clamp(32px, 4vw, 56px); max-width: 50ch; color: var(--c-body); }
  @media (max-width: 860px) { .pillars { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) {
    .venn { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; justify-items: center; }
    .venn-c { width: clamp(120px, 40vw, 180px); height: clamp(120px, 40vw, 180px); margin-right: 0; font-size: clamp(18px, 5vw, 26px); }
  }
  @media (max-width: 560px) { .pillars { grid-template-columns: 1fr; } }

  /* Founder */
  .founder { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 80px); align-items: center; }
  .founder-photo { border-radius: var(--radius-xl); overflow: hidden; box-shadow: 0 40px 80px rgba(30,20,109,0.35); aspect-ratio: 15 / 14; }
  .founder-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .founder-body { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .founder-h { font-size: var(--t-h2); }
  .founder-sub { color: var(--c-lilac-2) !important; }
  .founder-cta { margin-top: 6px; }
  @media (max-width: 860px) { .founder { grid-template-columns: 1fr; } .founder-photo { max-width: 480px; } }

  /* Steps */
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 3vw, 40px); }
  .step { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .step-no { width: clamp(88px, 10vw, 160px); height: clamp(88px, 10vw, 160px); font-size: clamp(36px, 4.5vw, 72px); }
  .step-purple { background: var(--c-purple); color: #fff; }
  .step-indigo { background: var(--c-indigo); color: #fff; }
  .step-white  { background: #fff; color: var(--c-purple); }
  .step-name { font-size: var(--t-h3); }
  .step-line { color: var(--c-body); }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; gap: 40px; } }

  /* Thesis */
  .thesis-wrap { padding-block: clamp(96px, 11vw, 160px); }
  .thesis { max-width: 1000px; text-align: center; margin-inline: auto; display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .thesis-q { font-size: var(--t-h1); max-width: 12ch; }
  .thesis-body { color: var(--c-body); max-width: 48ch; }

  /* Quotes */
  .quotes { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(28px, 3vw, 40px); }
  .quote-lead { display: flex; flex-direction: column; gap: 24px; }
  .quote-mark { font-family: var(--f-display); font-weight: 800; font-size: clamp(96px, 10vw, 160px); line-height: 0.5; color: var(--c-lilac); }
  .quote-lead-text { font-size: clamp(26px, 2.6vw + 8px, 52px); line-height: 1.2; max-width: 24ch; color: #fff; }
  .quote-who { font-size: var(--t-body); font-weight: 600; color: var(--c-lilac); }
  .quotes-rest {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(24px, 3vw, 40px);
    width: 100%; margin-top: 16px; padding-top: clamp(28px, 3vw, 40px);
    border-top: 1px solid var(--c-rule-dark);
  }
  .quote { display: flex; flex-direction: column; gap: 12px; }
  .quote-text { color: var(--c-on-indigo); }
  @media (max-width: 760px) { .quotes-rest { grid-template-columns: 1fr; } }
</style>
