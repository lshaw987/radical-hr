---
import Base from '../layouts/Base.astro';
import IndigoBlock from '../components/IndigoBlock.astro';

const belief = 'Organisations need to radically change how they equip leaders for the future.';
const pain = 'Most teams are managed, not led - because managers are never given the time and development to become leaders.';

const blocks = [
  { name: 'Delevate', line: 'Lisa’s own leadership model: Deciding → Doing → Directing → Delegating → Developing → Delevating. Move from control to trust, from busyness to impact, and build a team strong enough to carry the weight together - protecting your hauora as you go.' },
  { name: 'Strengths', line: 'CliftonStrengths coaching for leaders and teams. Find what you and your people do best, then build around it - performance, belonging and real growth, not another model to memorise.' },
  { name: 'Coaching', line: 'Executive and leadership coaching, one-to-one and for leadership teams. Practical, strengths-based, and grounded in having actually carried the weight - never theory for hire.' },
];
---
<Base
  title="Lead"
  description="Radically change how you equip leaders - leadership development that builds people who multiply impact, not just manage."
  current="lead"
>
  <section class="hero">
    <div class="container hero-split">
      <div class="hero-copy">
      <p class="eyebrow">Pillar 03</p>
      <h1 class="display hero-h1">Build leaders who <span class="accent">multiply impact.</span></h1>
      <p class="body-lg hero-sub">
        Real leadership means building others strong enough to carry the weight
        with you - not carrying it alone. We grow the kind of leaders who
        empower, not control, and lift everyone around them.
      </p>
      <a href="/contact" class="btn btn-primary hero-cta">Talk leadership <span class="arr">&rarr;</span></a>
      </div>
      <div class="hero-photo">
        <img src="/images/lego-build.jpg" alt="A Lego build from a Lego Serious Play workshop." loading="eager" />
      </div>
    </div>
  </section>


  {/* Radical belief + the problem */}
  <section class="section-tight">
    <div class="container belief">
      <div class="belief-main">
        <p class="eyebrow">Our radical belief</p>
        <p class="heading belief-line">{belief}</p>
      </div>
      <div class="belief-pain">
        <p class="eyebrow">The problem</p>
        <p class="body-lg">{pain}</p>
      </div>
    </div>
  </section>

  <section class="section band-mist">
    <div class="container">
      <div class="blocks">
        {blocks.map((b) => (
          <div class="block">
            <h2 class="heading block-name">{b.name}</h2>
            <p class="body block-line">{b.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  {/* A story from the work - DRAFT from the client roster, anonymised. Lisa to check every fact before go-live. */}
  <section class="section story">
    <div class="container story-inner">
      <p class="eyebrow">From the work</p>
      <h2 class="heading story-h">It started as a conference session. It became a leadership programme.</h2>
      <p class="body-lg">An agribusiness advisory firm asked for CliftonStrengths at their annual conference - fifty-odd reports and a couple of sessions for the shareholders and the wider team.</p>
      <p class="body">The sessions landed, and the real conversation started afterwards: how do the consultants grow into leaders, and how does the firm hold on to them while they do? That became an ongoing engagement - development pathways for the consultants, coaching for the people stepping up, and support for the leaders carrying the load.</p>
      <p class="body story-turn">A year later we are still in the room. That is the pattern we like: start with something real and useful, and earn the bigger work.</p>
      <p class="story-note">A real engagement. Details changed to protect the client.</p>
    </div>
  </section>

  <IndigoBlock
    eyebrow="Pillar 03"
    heading="Leaders who empower, not control."
    body="Let’s grow the kind of leaders who lift everyone around them."
    ctaHref="/contact"
    ctaLabel="Start a conversation"
  />
</Base>

<style>
  .hero { padding-block: clamp(56px, 9vw, 116px) clamp(36px, 5vw, 64px); }
  .hero-h1 { font-size: var(--t-h1); max-width: 15ch; }
  .hero-sub { margin-top: 24px; max-width: 56ch; color: var(--c-body); }
  .hero-cta { margin-top: 32px; }

  .belief { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .belief .eyebrow { margin-bottom: 14px; }
  .belief-line { font-size: var(--t-h3); max-width: 22ch; }
  .belief-pain .body-lg { color: var(--c-body); }
  @media (max-width: 760px) { .belief { grid-template-columns: 1fr; gap: 24px; } }

  .blocks { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 24px); }
  .block { background: #fff; border: 1px solid var(--c-rule); border-radius: var(--radius); padding: clamp(24px, 3vw, 34px); display: flex; flex-direction: column; gap: 12px; }
  .block-name { font-size: var(--t-h4); color: var(--c-purple); }
  .block-line { color: var(--c-body); }

  @media (max-width: 760px) { .blocks { grid-template-columns: 1fr; } }
</style>
