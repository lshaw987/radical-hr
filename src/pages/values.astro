---
import Base from '../layouts/Base.astro';
import IndigoBlock from '../components/IndigoBlock.astro';

// The five value cards are the real Radical HR assets (title + icon + copy
// baked into each image). Pulled from the live site. NOTE for Lisa: the
// "Adding Value, Always" file has the wrong subtitle baked in (repeats the
// Future by Design line) plus minor typos - fix in Canva, then re-export.
const values = [
  { src: '/images/value-1-humans-first.png', alt: 'Humans First - humans are the core of extraordinary teams.' },
  { src: '/images/value-2-curiosity.png',   alt: 'Courageous Curiosity - be curious enough to ask, be courageous enough to act.' },
  { src: '/images/value-3-growth.png',      alt: 'Empowered Growth - empowered people empower others.' },
  { src: '/images/value-4-future.png',      alt: 'Future by Design - we don’t wait for the future, we design it.' },
  { src: '/images/value-5-value.png',       alt: 'Adding Value, Always - every action must matter.' },
];
---
<Base
  title="Values"
  description="At Radical HR, values aren’t corporate wallpaper. They must breathe - showing up in how we lead, design, challenge, and work with people every day."
  current="about"
>
  {/* Hero */}
  <section class="hero">
    <div class="container">
      <p class="eyebrow">What we stand for</p>
      <h1 class="display hero-h1">Our values</h1>
      <p class="body-lg hero-sub">
        More than words. They’re the principles that shape how we think, partner,
        and grow - guiding every conversation, every decision, and every act of
        courage and care.
      </p>
    </div>
  </section>

  {/* Core statement */}
  <section class="section-tight">
    <div class="container statement">
      <p class="heading statement-h">
        We aren’t interested in creating more corporate wallpaper. Values must
        <span class="accent"> breathe.</span>
      </p>
      <p class="body-lg">
        They must show up in how we lead, design, challenge, and work with
        people every day. Not buzzwords, not a branding exercise - the
        foundation. Our compass when things get messy, our reminder of what
        matters most, and the reason we do what we do.
      </p>
      <p class="body-lg statement-turn">
        Because when values are real, they’re not just written. They’re felt.
      </p>
    </div>
  </section>

  {/* The five, at a glance */}
  <section class="section-tight">
    <div class="container">
      <img
        class="values-strip"
        src="/images/values-banner.png"
        alt="The five Radical HR values: Humans First, Courageous Curiosity, Empowered Growth, Future by Design, Adding Value Always."
        loading="lazy"
      />
    </div>
  </section>

  {/* The five values - real card assets */}
  <section class="section band-mist">
    <div class="container">
      <div class="vals">
        {values.map((v) => (
          <div class="val-card">
            <img src={v.src} alt={v.alt} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <IndigoBlock
    eyebrow="Humans First"
    heading="Values you can feel, not just read."
    body="If you want a culture that actually lives its values - not a poster on the wall - let’s talk about what that looks like for your team."
    ctaHref="/contact"
    ctaLabel="Start a conversation"
  />
</Base>

<style>
  .hero { padding-block: clamp(56px, 9vw, 116px) clamp(28px, 4vw, 56px); }
  .hero-h1 { font-size: var(--t-h1); }
  .hero-sub { margin-top: 24px; max-width: 52ch; color: var(--c-body); }

  .statement { display: flex; flex-direction: column; gap: 20px; max-width: 64ch; }
  .statement-h { font-size: var(--t-h3); line-height: 1.2; }
  .statement .body-lg { color: var(--c-body); }
  .statement-turn { font-family: var(--f-display); font-weight: 700; color: var(--c-indigo) !important; font-size: var(--t-body-lg) !important; }

  .values-strip { width: 100%; max-width: 980px; height: auto; display: block; margin-inline: auto; }

  .vals {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2vw, 28px);
  }
  .val-card {
    background: #fff;
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    padding: clamp(12px, 1.5vw, 20px);
    overflow: hidden;
    transition: transform .18s var(--ease-out), box-shadow .18s var(--ease-out);
  }
  .val-card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(101,40,234,0.08); }
  .val-card img { width: 100%; height: auto; display: block; border-radius: 8px; }

  @media (max-width: 860px) { .vals { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .vals { grid-template-columns: 1fr; max-width: 360px; margin-inline: auto; } }
</style>
