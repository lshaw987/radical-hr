---
import Base from '../layouts/Base.astro';
import IndigoBlock from '../components/IndigoBlock.astro';

// The five values as live text (Lisa, 13 Sept: the baked-image cards were
// "ick"). Icons are cropped from the real values banner. Taglines are the
// canonical ones from the spine; the one-line "role" is Lisa's own frame for
// the set (heart / mindset / method / forward energy / measure).
const values = [
  { icon: '/images/value-icon-humans-first.png', name: 'Humans First', role: 'The heart', tag: 'Humans are the core of extraordinary teams.', line: 'People aren’t resources. They’re the reason organisations succeed. Every piece of work starts and ends with the humans in it.' },
  { icon: '/images/value-icon-curiosity.png', name: 'Courageous Curiosity', role: 'The mindset', tag: 'Be curious enough to ask. Be courageous enough to act.', line: 'Curiosity is the mindset, courage is the behaviour, learning and change are the outcome. Without courage, curiosity stays theory.' },
  { icon: '/images/value-icon-growth.png', name: 'Empowered Growth', role: 'The method', tag: 'Empowered people empower others.', line: 'We build capability, not dependence. Leaders who grow the people around them, and teams strong enough to carry the weight together.' },
  { icon: '/images/value-icon-future.png', name: 'Future by Design', role: 'The forward energy', tag: 'We don’t wait for the future - we design it.', line: 'The future of work is human. We help people shape it on purpose, rather than have it happen to them.' },
  { icon: '/images/value-icon-value.png', name: 'Adding Value, Always', role: 'The measure', tag: 'Every action must matter.', line: 'If it doesn’t make a real difference for the people and the organisation, we don’t do it. Value given before value asked.' },
];
---
<Base
  title="Values"
  description="At Radical HR, values aren’t corporate wallpaper. They must breathe - showing up in how we lead, design, challenge, and work with people every day."
  current="about"
>
  {/* Hero */}
  <section class="hero">
    <div class="container hero-split">
      <div class="hero-copy">
        <p class="eyebrow">What we stand for</p>
        <h1 class="display hero-h1">Our values</h1>
        <p class="body-lg hero-sub">
          More than words. They’re the principles that shape how we think, partner,
          and grow - guiding every conversation, every decision, and every act of
          courage and care.
        </p>
      </div>
      <div class="hero-icons" aria-hidden="true">
        {values.map((v) => <img src={v.icon} alt="" loading="eager" />)}
      </div>
    </div>
  </section>

  {/* Core statement */}
  <section class="section-tight">
    <div class="container statement">
      <p class="heading statement-h">
        We aren’t interested in creating more corporate wallpaper. Values must
        <span class="accent"> breathe.</span>
      </p>
      <p class="body-lg">
        They must show up in how we lead, design, challenge, and work with
        people every day. Not buzzwords, not a branding exercise - the
        foundation. Our compass when things get messy, our reminder of what
        matters most, and the reason we do what we do.
      </p>
      <p class="body-lg statement-turn">
        Because when values are real, they’re not just written. They’re felt.
      </p>
    </div>
  </section>

  {/* The five values */}
  <section class="section band-mist">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The five</p>
        <h2 class="heading section-title">One heart, one mindset, one method, one direction, one measure.</h2>
      </div>
      <div class="vals">
        {values.map((v, i) => (
          <div class="val">
            <div class="val-icon"><img src={v.icon} alt="" loading="lazy" /></div>
            <div class="val-body">
              <div class="val-top">
                <span class="val-no">0{i + 1}</span>
                <span class="val-role">{v.role}</span>
              </div>
              <h3 class="heading val-name">{v.name}</h3>
              <p class="val-tag">{v.tag}</p>
              <p class="body val-line">{v.line}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <IndigoBlock
    eyebrow="Humans First"
    heading="Values you can feel, not just read."
    body="If you want a culture that actually lives its values - not a poster on the wall - let’s talk about what that looks like for your team."
    ctaHref="/contact"
    ctaLabel="Start a conversation"
  />
</Base>

<style>
  .hero-h1 { font-size: var(--t-h1); }
  .hero-sub { margin-top: 20px; max-width: 46ch; color: var(--c-body); }
  .hero-icons { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; align-items: center; }
  .hero-icons img { width: clamp(64px, 6.5vw, 96px); height: auto; }

  .statement { max-width: 64ch; display: flex; flex-direction: column; gap: 18px; }
  .statement-h { font-size: var(--t-h3); }
  .statement .body-lg { color: var(--c-body); }
  .statement-turn { font-weight: 600; color: var(--c-indigo) !important; }

  .section-title { font-size: var(--t-h2); max-width: 18ch; }
  .vals { display: flex; flex-direction: column; gap: clamp(16px, 2vw, 24px); }
  .val {
    display: grid; grid-template-columns: 160px 1fr; gap: clamp(20px, 3vw, 40px); align-items: center;
    background: #fff; border-radius: var(--radius-lg); padding: clamp(20px, 3vw, 36px);
  }
  .val-icon img { width: 100%; height: auto; }
  .val-body { display: flex; flex-direction: column; gap: 8px; }
  .val-top { display: flex; align-items: center; gap: 12px; }
  .val-no { font-family: var(--f-display); font-weight: 700; font-size: 13px; letter-spacing: 0.1em; color: var(--c-purple); }
  .val-role { font-size: var(--t-label); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-purple); background: var(--c-lilac-3); border-radius: 999px; padding: 6px 12px; }
  .val-name { font-size: var(--t-h3); }
  .val-tag { font-family: var(--f-display); font-weight: 600; font-size: var(--t-body-lg); color: var(--c-indigo); font-style: italic; }
  .val-line { color: var(--c-body); max-width: 60ch; }
  @media (max-width: 760px) {
    .val { grid-template-columns: 1fr; }
    .val-icon { max-width: 140px; }
  }
</style>
