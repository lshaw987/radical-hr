---
import Base from '../layouts/Base.astro';
import IndigoBlock from '../components/IndigoBlock.astro';

const belief = 'All talent attraction should be driven by values, first.';
const pain = 'Almost every HR and people problem starts with poor recruitment. Hire for the wrong reasons and you pay for it for years.';

const blocks = [
  { name: 'Innovative Hiring', line: 'We design a values-based approach to recruitment that finds great people who love the job, have the right experience, and align to the values and ethos of your organisation.' },
  { name: 'Creative Attraction', line: 'Talent attraction is so much more than throwing an ad on a job board and hoping for the best. Our talent marketers help you attract the right people, creatively and cost-effectively.' },
  { name: 'Unconventional Recruitment', line: 'Finding a job you love can feel like a needle in a haystack. Our end-to-end recruitment uses a research team to surface people who are passive in the market and have the transferable skills you’re really after.' },
];
---
<Base
  title="Attract"
  description="Values-based recruitment that attracts people who love the job - team fit and role fit, for culture and performance that lasts."
  current="attract"
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Pillar 01</p>
      <h1 class="display hero-h1">Attract the right humans.</h1>
      <p class="body-lg hero-sub">
        Forget cookie-cutter recruitment. We help you bring in people who
        believe in your mission, not just fill a seat - humans who co-create your
        culture and love the work they do.
      </p>
      <a href="/contact" class="btn btn-primary hero-cta">Talk recruitment <span class="arr">&rarr;</span></a>
    </div>
  </section>

  {/* Radical belief + the problem */}
  <section class="section-tight">
    <div class="container belief">
      <div class="belief-main">
        <p class="eyebrow">Our radical belief</p>
        <p class="heading belief-line">{belief}</p>
      </div>
      <div class="belief-pain">
        <p class="eyebrow">The problem</p>
        <p class="body-lg">{pain}</p>
      </div>
    </div>
  </section>

  <section class="section band-mist">
    <div class="container">
      <div class="blocks">
        {blocks.map((b) => (
          <div class="block">
            <h2 class="heading block-name">{b.name}</h2>
            <p class="body block-line">{b.line}</p>
          </div>
        ))}
      </div>
      <p class="body-sm honest">
        And if we can’t help you, we’ll be honest and upfront and tell you.
      </p>
    </div>
  </section>

  <IndigoBlock
    eyebrow="Pillar 01"
    heading="Hiring for fit, not just a CV."
    body="Tell us about the team you’re building and the people you need in it."
    ctaHref="/contact"
    ctaLabel="Start a conversation"
  />
</Base>

<style>
  .hero { padding-block: clamp(56px, 9vw, 116px) clamp(36px, 5vw, 64px); }
  .hero-h1 { font-size: var(--t-h1); max-width: 16ch; }
  .hero-sub { margin-top: 24px; max-width: 54ch; color: var(--c-body); }
  .hero-cta { margin-top: 32px; }

  .belief { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .belief .eyebrow { margin-bottom: 14px; }
  .belief-line { font-size: var(--t-h3); max-width: 22ch; }
  .belief-pain .body-lg { color: var(--c-body); }
  @media (max-width: 760px) { .belief { grid-template-columns: 1fr; gap: 24px; } }

  .blocks { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 24px); }
  .block { background: #fff; border: 1px solid var(--c-rule); border-radius: var(--radius); padding: clamp(24px, 3vw, 34px); display: flex; flex-direction: column; gap: 12px; }
  .block-name { font-size: var(--t-h4); color: var(--c-purple); }
  .block-line { color: var(--c-body); }
  .honest { margin-top: 28px; }

  @media (max-width: 760px) { .blocks { grid-template-columns: 1fr; } }
</style>
